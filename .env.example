# Conexão usada por migrate.sh, import e servidor de referência
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estudy
# Banco administrativo (tests/run.sh cria/apaga estudy_test por aqui)
ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Ciclo em que um aluno novo é matriculado automaticamente
DEFAULT_TERM=2026.2
# Em produção o servidor faz login com um papel que seja membro APENAS de estudy_app:
#   CREATE ROLE estudy_api LOGIN PASSWORD '...'; GRANT estudy_app TO estudy_api;
